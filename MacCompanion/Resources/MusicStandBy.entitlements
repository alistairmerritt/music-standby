<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Needed to send Apple Events to Music under the hardened runtime.
	     Not sandboxed: a sandboxed build would also need
	     com.apple.security.app-sandbox and a
	     com.apple.security.temporary-exception.apple-events entry for com.apple.Music. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
